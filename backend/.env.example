# Server
NODE_ENV=production
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Backups (see bin/backup.js)
# Default folder is E:\backups\security-app. Keep it outside the repo.
BACKUP_DIR=E:\backups\security-app
# Password for backup archives (7z, AES-256). Required unless --no-encrypt is used.
# Keep a copy somewhere safe: without it, the archives cannot be opened.
BACKUP_PASSPHRASE=replace_with_a_passphrase_of_at_least_12_chars
# 7-Zip command line tool (default install location on Windows)
SEVEN_ZIP_PATH=C:\Program Files\7-Zip\7z.exe
# Leave as "mongodump" / "mongorestore" if they are on PATH
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URLs (comma-separated, for CORS)
FRONTEND_URLS=https://your-frontend-domain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed Scripts
ADMIN_USER_ID=
ADMIN_NAME=
ADMIN_PASSWORD=

DEVELOPER_USER_ID=
DEVELOPER_NAME=
DEVELOPER_PASSWORD=

SUPERVISOR_USER_ID=
SUPERVISOR_NAME=
SUPERVISOR_PASSWORD=
